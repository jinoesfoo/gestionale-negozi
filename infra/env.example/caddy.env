# Esempio di /srv/app/env/caddy.env (servizio caddy).
# Ogni valore con CAMBIA va sostituito. Nessuno schema legge questo file: prima di avviare Caddy,
# grep -c '^[^#]*CAMBIA' /srv/app/env/caddy.env deve rispondere 0 (01 §Variabili d'ambiente).
BASE_DOMAIN=CAMBIA.example
ACME_EMAIL=avvisi@CAMBIA.example
# Token Cloudflare limitato alla zona, con Zone › Zone › Read e Zone › DNS › Edit.
CF_API_TOKEN=CAMBIA
