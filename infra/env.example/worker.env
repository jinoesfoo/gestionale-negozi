# Esempio di /srv/app/env/worker.env (servizio worker). I valori veri li scrive l'utente sul server.
# Ogni valore con CAMBIA va sostituito: se ne resta uno, il worker non parte e nomina la variabile.
# Un segnaposto (un valore che inizia con placeholder) va solo dove lo dice il commento della
# variabile: tutte le altre hanno il valore vero fin dal primo avvio (01 §Variabili d'ambiente).
# APP_VERSION non va qui: la imposta l'immagine. Mai DATABASE_OWNER_URL qui.
NODE_ENV=production
# test sul server di test, prod in produzione
APP_ENV=CAMBIA
# Solo il nome di dominio: senza https://, porta, / o punto finale.
PUBLIC_BASE_DOMAIN=CAMBIA.example

DATABASE_URL=postgres://app_worker:CAMBIA-password-app-worker@postgres:5432/app
DATABASE_JOBS_URL=postgres://app_jobs:CAMBIA-password-app-jobs@postgres:5432/app

# Le stesse di app.env.
JOB_PAYLOAD_KEY=CAMBIA-32-byte-base64
SHOP_SECRETS_KEY=CAMBIA-32-byte-base64-diversa

STRIPE_SECRET_KEY=sk_test_CAMBIA

# Nome del fornitore scelto in BIL-T11, con chiave e indirizzo della sua API; fino ad allora
# tre segnaposto che iniziano con placeholder (avvio iniziale, FON-T07b).
SDI_PROVIDER=CAMBIA
SDI_API_KEY=CAMBIA
SDI_API_URL=https://sdi.CAMBIA.example

# https:// e l'host del fornitore, senza percorso: il bucket va in S3_BUCKET.
S3_ENDPOINT=https://s3.CAMBIA.example
S3_REGION=CAMBIA
S3_BUCKET=CAMBIA
S3_ACCESS_KEY_ID=CAMBIA
S3_SECRET_ACCESS_KEY=CAMBIA

EMAIL_API_KEY=CAMBIA
EMAIL_FROM=noreply@CAMBIA.example
# Uguale su tutti i server: anche il server di test invia email vere (06 §DNS). Solo sviluppo e CI usano fake.
EMAIL_PROVIDER=brevo
# Fino a OPS-T04 un segnaposto che inizia con placeholder (avvio iniziale, FON-T07b).
SENTRY_DSN=https://CAMBIA@sentry.example/1

ADMIN_ALERT_EMAIL=avvisi@CAMBIA.example
