# Esempio di /srv/app/env/postgres.env (servizio postgres e pgbackrest-init; OPS-T01a).
POSTGRES_DB=app
# Valore fisso: pgBackRest si collega come postgres.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIA
# Usate solo da 01-roles.sh alla creazione del volume.
APP_OWNER_PASSWORD=CAMBIA
APP_USER_PASSWORD=CAMBIA
APP_WORKER_PASSWORD=CAMBIA
APP_JOBS_PASSWORD=CAMBIA

PGBACKREST_REPO1_S3_ENDPOINT=s3.CAMBIA.example
PGBACKREST_REPO1_S3_BUCKET=CAMBIA
PGBACKREST_REPO1_S3_REGION=CAMBIA
PGBACKREST_REPO1_S3_KEY=CAMBIA
PGBACKREST_REPO1_S3_KEY_SECRET=CAMBIA
PGBACKREST_REPO1_CIPHER_PASS=CAMBIA
