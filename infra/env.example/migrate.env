# Esempio di /srv/app/env/migrate.env (servizio migrate: migrazioni, CLI, isolation-check).
# Unico file dei server con le credenziali del proprietario. APP_VERSION non va qui.
# La chiave sk_live_ del CLI non sta mai in un file di ambiente (01 §Variabili d'ambiente).
NODE_ENV=production
# test sul server di test, prod in produzione
APP_ENV=prod
PUBLIC_BASE_DOMAIN=dominio.example

DATABASE_OWNER_URL=postgres://app_owner:CAMBIA-password-app-owner@postgres:5432/app
# Per jobs:send (C26).
DATABASE_JOBS_URL=postgres://app_jobs:CAMBIA-password-app-jobs@postgres:5432/app
# Per isolation-check (C12).
ISOLATION_APP_DATABASE_URL=postgres://app_user:CAMBIA-password-app-user@postgres:5432/app

# Chiave sk_test_ della sandbox di questo server, per sempre (anche dopo le chiavi reali).
STRIPE_SECRET_KEY=sk_test_CAMBIA
# true solo per la prova C08 del collaudo (09).
STRIPE_TEST_CLOCK_SETUP= # facoltativa

S3_ENDPOINT=https://s3.CAMBIA.example
S3_REGION=CAMBIA
S3_BUCKET=CAMBIA
S3_ACCESS_KEY_ID=CAMBIA
S3_SECRET_ACCESS_KEY=CAMBIA

ADMIN_ALERT_EMAIL=avvisi@dominio.example
