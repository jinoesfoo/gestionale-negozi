# Esempio di /srv/app/env/app.env (servizio app). I valori veri li scrive l'utente sul server.
# Ogni valore con CAMBIA va sostituito: se ne resta uno, l'app non parte e nomina la variabile.
# Un segnaposto (un valore che inizia con placeholder) va solo dove lo dice il commento della
# variabile: tutte le altre, tranne le facoltative ancora vuote, hanno il valore vero fin dal
# primo avvio (01 §Variabili d'ambiente).
# APP_VERSION non va qui: la imposta l'immagine. Mai DATABASE_OWNER_URL qui.
# Il segno "# facoltativa" fa saltare la variabile al controllo di deploy.sh (FON-T08).
# Una variabile facoltativa ancora senza valore si scrive NOME="" # facoltativa: Compose toglie gli
# spazi dopo "=", e con NOME= # facoltativa leggerebbe il commento come valore.
# Per dare un valore si sostituisce "" per intero (NOME=valore), mai accanto alle virgolette.
NODE_ENV=production
# test sul server di test, prod in produzione
APP_ENV=CAMBIA
PUBLIC_BASE_DOMAIN=CAMBIA.example

DATABASE_URL=postgres://app_user:CAMBIA-password-app-user@postgres:5432/app
DATABASE_JOBS_URL=postgres://app_jobs:CAMBIA-password-app-jobs@postgres:5432/app

# Almeno 32 caratteri casuali.
BETTER_AUTH_SECRET=CAMBIA-almeno-32-caratteri-casuali
# 32 byte casuali in base64 (openssl rand -base64 32), diverse fra loro; mai nei backup.
JOB_PAYLOAD_KEY=CAMBIA-32-byte-base64
SHOP_SECRETS_KEY=CAMBIA-32-byte-base64-diversa

# Chiave sk_test_ della sandbox di questo server, fin dal primo avvio (FON-T07b).
STRIPE_SECRET_KEY=sk_test_CAMBIA
# Fino a BIL-T02 un segnaposto che inizia con placeholder (avvio iniziale, FON-T07b).
STRIPE_WEBHOOK_SECRET=whsec_CAMBIA
# Resta "" fino a BIL-T01: si aggiunge dopo il primo stripe:seed (05).
STRIPE_PORTAL_CONFIGURATION_ID="" # facoltativa

S3_ENDPOINT=https://s3.CAMBIA.example
S3_REGION=CAMBIA
S3_BUCKET=CAMBIA
S3_ACCESS_KEY_ID=CAMBIA
S3_SECRET_ACCESS_KEY=CAMBIA

# Almeno 32 caratteri casuali.
EMAIL_WEBHOOK_TOKEN=CAMBIA-almeno-32-caratteri-casuali
# Fino a OPS-T04 un segnaposto che inizia con placeholder (avvio iniziale, FON-T07b).
SENTRY_DSN=https://CAMBIA@sentry.example/1

# Valore vero fin dal primo avvio (FON-T07b), non da OPS-T04: qui un segnaposto non vale.
HEALTH_TOKEN=CAMBIA
ADMIN_ALERT_EMAIL=avvisi@CAMBIA.example
