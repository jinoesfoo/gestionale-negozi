#!/usr/bin/env bash
# /srv/app/dc (01 §CI/CD, FON-T06; installato sui server in DOM-T02): `docker compose` sul progetto dei server, sempre
# con gli stessi argomenti, così deploy.sh, backup.sh, i timer e gli script parlano allo stesso progetto e leggono gli
# stessi tag:
#
#   docker compose -p app --project-directory /srv/app --env-file /srv/app/.env \
#     -f /srv/app/infra/compose.yml -f /srv/app/infra/compose.<ambiente>.yml <argomenti>
#
# L'ambiente lo legge da /srv/app/deploy-env: una sola riga, `test` oppure `prod`, scritta in DOM-T02 e mai toccata
# da deploy.sh. Un file mancante o un altro valore è un errore, e docker non viene chiamato. Il codice di uscita è
# quello di docker compose. Il blocco contro due comandi insieme lo aggiunge FON-T08.
#
#   /srv/app/dc ps
#   /srv/app/dc run --rm migrate node dist/cli.js --help
#
# DC_ROOT (predefinita /srv/app) serve solo ai test (tests/unit/infra/dc.test.ts), che lo provano in una cartella
# temporanea.
set -euo pipefail

root="${DC_ROOT:-/srv/app}"
deploy_env_file="$root/deploy-env"

if [ ! -f "$deploy_env_file" ]; then
  echo "dc: manca $deploy_env_file (una sola riga: test oppure prod)." >&2
  exit 1
fi

# Il contenuto esatto, con i ritorni a capo finali (la x impedisce a $(…) di toglierli).
content="$(cat -- "$deploy_env_file" && printf x)"
content="${content%x}"
case "$content" in
  test | test$'\n') environment=test ;;
  prod | prod$'\n') environment=prod ;;
  *)
    echo "dc: $deploy_env_file deve contenere una sola riga, test oppure prod." >&2
    exit 1
    ;;
esac

exec docker compose -p app --project-directory "$root" --env-file "$root/.env" \
  -f "$root/infra/compose.yml" -f "$root/infra/compose.$environment.yml" "$@"
