# Variabili di db:migrate, db:generate e del CLI in sviluppo. Copia in .env.migrate e adatta.
# Unico file di sviluppo con le credenziali del proprietario. Valori di prova.
NODE_ENV=development
APP_ENV=dev
PUBLIC_BASE_DOMAIN=localhost
APP_VERSION=dev

DATABASE_OWNER_URL=postgres://app_owner:dev-password-app-owner@127.0.0.1:5432/app
# Solo per jobs:send (07, C26).
DATABASE_JOBS_URL=postgres://app_jobs:dev-password-app-jobs@127.0.0.1:5432/app
# Solo per isolation-check (C12).
ISOLATION_APP_DATABASE_URL=postgres://app_user:dev-password-app-user@127.0.0.1:5432/app

# Solo per i comandi Stripe, che la accettano solo se inizia con sk_test_.
STRIPE_SECRET_KEY=placeholder-stripe-secret
# Solo per billing:test-clock-customer (05 §Test): true per attivarlo.
STRIPE_TEST_CLOCK_SETUP=

# Emulatore S3 di infra/compose.dev.yml.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=eu-central-1
S3_BUCKET=app-dev
S3_ACCESS_KEY_ID=dev-s3-access-key
S3_SECRET_ACCESS_KEY=dev-s3-secret-key

ADMIN_ALERT_EMAIL=avvisi@example.com
