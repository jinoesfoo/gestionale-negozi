# Variabili dell'app in sviluppo (pnpm dev). Copia in .env.app e adatta.
# Valori di prova, nessuno è un segreto vero. Mai DATABASE_OWNER_URL qui (FON-002).
NODE_ENV=development
APP_ENV=dev
PUBLIC_BASE_DOMAIN=localhost
APP_VERSION=dev

DATABASE_URL=postgres://app_user:dev-password-app-user@127.0.0.1:5432/app
DATABASE_JOBS_URL=postgres://app_jobs:dev-password-app-jobs@127.0.0.1:5432/app

BETTER_AUTH_SECRET=dev-better-auth-secret-0123456789abcdef
JOB_PAYLOAD_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
SHOP_SECRETS_KEY=AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI=

STRIPE_SECRET_KEY=placeholder-stripe-secret
STRIPE_WEBHOOK_SECRET=placeholder-stripe-webhook
# Si aggiunge dopo il primo stripe:seed (05).
STRIPE_PORTAL_CONFIGURATION_ID=

# Emulatore S3 di infra/compose.dev.yml.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=eu-central-1
S3_BUCKET=app-dev
S3_ACCESS_KEY_ID=dev-s3-access-key
S3_SECRET_ACCESS_KEY=dev-s3-secret-key

EMAIL_WEBHOOK_TOKEN=dev-email-webhook-token-0123456789abcdef
SENTRY_DSN=placeholder-sentry-dsn
HEALTH_TOKEN=dev-health-token
ADMIN_ALERT_EMAIL=avvisi@example.com
