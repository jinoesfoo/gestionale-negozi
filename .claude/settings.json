{
  "model": "claude-opus-5-5",
  "permissions": {
    "deny": [
      "PowerShell",
      "Monitor",
      "EnterWorktree",
      "ExitWorktree",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.app)",
      "Read(.env.worker)",
      "Read(.env.migrate)",
      "Read(.env.test)",
      "Read(.env.test.owner)",
      "Read(.env.test.local)",
      "Read(.env.development)",
      "Read(.env.development.local)",
      "Read(.env.production)",
      "Read(.env.production.local)",
      "Read(**/env/*.env)",
      "Edit(/.claude/**)",
      "Edit(**/CLAUDE.md)",
      "Edit(**/CLAUDE.local.md)",
      "Edit(/.mcp.json)",
      "Edit(/AVVIO.md)",
      "Edit(/.gitmodules)",
      "Edit(/.github/CODEOWNERS)",
      "Edit(/docs/metodo.md)",
      "Edit(/docs/due-postazioni.md)",
      "Edit(/.vscode/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.claude/CLAUDE.md)",
      "Edit(~/.claude/agents/**)",
      "Edit(~/.claude/commands/**)",
      "Edit(~/.claude/skills/**)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.claude.json)",
      "Edit(~/.local/state/gestionale-negozi/**)"
    ],
    "ask": [
      "Bash(ssh *prod*)",
      "Bash(scp *prod:*)",
      "Bash(rsync *prod:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "registry.npmjs.org",
        "api.stripe.com",
        "api.brevo.com"
      ]
    },
    "filesystem": {
      "allowWrite": ["~/.local/share/pnpm/store", "~/.cache/pnpm", "~/.local/state/pnpm"],
      "denyWrite": [
        "./.claude",
        "./CLAUDE.md",
        "./CLAUDE.local.md",
        "./.mcp.json",
        "./AVVIO.md",
        "./docs/metodo.md",
        "./docs/due-postazioni.md",
        "./.gitmodules",
        "./.github/CODEOWNERS",
        "./.git/info/exclude",
        "./.git/info/attributes",
        "./.git/CLAUDE.md",
        "./.git/CLAUDE.local.md",
        "~/.local/state/gestionale-negozi"
      ]
    },
    "excludedCommands": [
      "docker *",
      "ssh *",
      "scp *",
      "rsync *",
      "bash .claude/hooks/gabbia.sh *"
    ]
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          { "type": "command", "command": "echo 'Il metodo non usa worktree: ogni postazione lavora in una sola cartella, perché hook, stato e controlli dei file del metodo sono legati a quella cartella (docs/due-postazioni.md). Se un worktree serve davvero, lo crea chi usa il computer, nel suo terminale e fuori dal progetto.' >&2; exit 2" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh", "onFailure": "block" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/prompt-gate.sh", "onFailure": "block" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Read|Grep",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/file-guard.sh", "onFailure": "block" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bash-guard.sh", "onFailure": "block" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-guard.sh", "timeout": 900 }
        ]
      }
    ]
  }
}
