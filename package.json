{
  "name": "gestionale-negozi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node -e \"process.loadEnvFile('.env.app'); const c = require('node:child_process').spawn('next', ['dev', '-H', '127.0.0.1', ...process.argv.slice(1)], { stdio: 'inherit' }); for (const s of ['SIGINT', 'SIGTERM', 'SIGHUP']) process.on(s, () => c.kill(s)); c.on('error', (e) => { console.error(e.message); process.exit(1); }); c.on('exit', (code, signal) => process.exit(code ?? 128 + require('node:os').constants.signals[signal]));\" --",
    "build": "next build",
    "build:dist": "tsup",
    "worker": "node --env-file=.env.worker --import tsx src/worker.ts",
    "cli": "node --env-file=.env.migrate --import tsx src/cli.ts",
    "email:prova": "node --env-file=.env.worker --import tsx src/server/email/probe.ts",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project int-app --project int-worker",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.migrate --import tsx src/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
