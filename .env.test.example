# Variabili dei test (Vitest e Playwright). Copia in .env.test e adatta.
# Next.js con NODE_ENV=test carica questo file da sé: mai le credenziali del proprietario qui,
# stanno solo in .env.test.owner. Valori di prova, nessuno è un segreto vero.
NODE_ENV=test
APP_ENV=test
PUBLIC_BASE_DOMAIN=localhost

# Connessioni per ruolo al database app dello sviluppo, quello che db:migrate prepara: il setup
# dei test copia quella del ruolo in DATABASE_URL.
TEST_DATABASE_APP_URL=postgres://app_user:dev-password-app-user@127.0.0.1:5432/app
TEST_DATABASE_WORKER_URL=postgres://app_worker:dev-password-app-worker@127.0.0.1:5432/app
TEST_DATABASE_JOBS_URL=postgres://app_jobs:dev-password-app-jobs@127.0.0.1:5432/app
DATABASE_JOBS_URL=postgres://app_jobs:dev-password-app-jobs@127.0.0.1:5432/app

BETTER_AUTH_SECRET=test-better-auth-secret-0123456789abcdef
JOB_PAYLOAD_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
SHOP_SECRETS_KEY=AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI=

STRIPE_SECRET_KEY=placeholder-stripe-secret
STRIPE_WEBHOOK_SECRET=placeholder-stripe-webhook

SDI_PROVIDER=fake

# Emulatore S3 di infra/compose.dev.yml, con lo stesso bucket dello sviluppo.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=eu-central-1
S3_BUCKET=app-dev
S3_ACCESS_KEY_ID=dev-s3-access-key
S3_SECRET_ACCESS_KEY=dev-s3-secret-key

EMAIL_API_KEY=test-email-api-key
EMAIL_FROM=noreply@example.com
EMAIL_WEBHOOK_TOKEN=test-email-webhook-token-0123456789abcdef
SENTRY_DSN=placeholder-sentry-dsn
HEALTH_TOKEN=test-health-token
ADMIN_ALERT_EMAIL=avvisi@example.com
