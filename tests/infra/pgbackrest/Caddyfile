# Proxy TLS della prova con Docker di OPS-T01a (run.sh e compose.yml di questa cartella; 01 §Servizi, esito del
# [VERIFICA] sull'ingresso TLS dell'emulatore): HTTPS con un certificato interno di Caddy davanti all'emulatore S3, e
# il registro degli accessi in JSON sull'uscita del container, dove run.sh conta le richieste per nome dell'host
# (s3-tls per postgres, s3-tls-init per pgbackrest-init). Caddy passa l'intestazione Host com'è, quindi la firma S3 di
# pgBackRest resta valida; nel registro Caddy scrive REDACTED al posto del valore di Authorization, che contiene la
# chiave S3 (run.sh controlla che nessun segreto di prova ci arrivi).
{
	admin off
	auto_https disable_redirects
	skip_install_trust
}

https://s3-tls:8443, https://s3-tls-init:8443 {
	tls internal
	log {
		output stdout
		format json
	}
	reverse_proxy s3:8333
}
